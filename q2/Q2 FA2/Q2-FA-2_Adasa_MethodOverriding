class Patient:
    def __init__(self, name, bill_amount):
        self.__name = name
        self.__bill_amount = bill_amount

    def get_name(self):
        return self.__name

    def set_name(self, name):
        self.__name = name

    def get_bill_amount(self):
        return self.__bill_amount

    def set_bill_amount(self, amount):
        self.__bill_amount = amount

    def calculate_bill(self):
        return self.__bill_amount


class SeniorPatient(Patient):
    def calculate_bill(self):
        return self.get_bill_amount() * 0.80


class PhilHealthPatient(Patient):
    def calculate_bill(self):
        return self.get_bill_amount() * 0.85


senior = SeniorPatient("Juan", 10000)
philhealth = PhilHealthPatient("Maria", 10000)

print("Hospital Billing System")
print()

print("Senior Patient:", senior.get_name())
print("Bill Amount:", senior.get_bill_amount())
print("Final Bill:", senior.calculate_bill())
print()

print("PhilHealth Patient:", philhealth.get_name())
print("Bill Amount:", philhealth.get_bill_amount())
print("Final Bill:", philhealth.calculate_bill())
